{
	"name": "opus-classical",
	"type": "module",
	"packageManager": "bun@1.2.18",
	"scripts": {
		"dev": "NODE_ENV=development bun run --hot src/server.ts",
		"prod": "NODE_ENV=production bun run src/server.ts",
		"build:css": "bunx @tailwindcss/cli -i ./src/assets/styles.css -o ./public/styles.css --minify",
		"dev:css": "bunx @tailwindcss/cli -i ./src/assets/styles.css -o ./public/styles.css --watch",
		"lint": "bunx biome check",
		"lint:fix": "bunx biome check --write",
		"test": "bun test",
		"test:coverage": "bun test --coverage"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.0.1",
		"@sentry/bun": "^9.35.0",
		"drizzle-orm": "^0.44.2",
		"fuse.js": "^7.1.0",
		"hono": "^4.8.4",
		"keyv": "^5.3.4",
		"pino": "^9.7.0",
		"pino-pretty": "^13.0.0",
		"quick-lru": "^7.0.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.1",
		"@tailwindcss/cli": "^4.1.11",
		"@types/bun": "^1.2.18",
		"tailwindcss": "^4.1.11",
		"typescript": "^5.8.3"
	}
}
