{
	"name": "opus-classical",
	"type": "module",
	"packageManager": "bun@1.2.20",
	"scripts": {
		"dev": "NODE_ENV=development bun run --hot src/server.ts",
		"prod": "NODE_ENV=production bun run src/server.ts",
		"build:css": "bunx @tailwindcss/cli -i ./src/assets/styles.css -o ./public/styles.css --minify",
		"dev:css": "bunx @tailwindcss/cli -i ./src/assets/styles.css -o ./public/styles.css --watch",
		"lint": "bunx biome check",
		"lint:fix": "bunx biome check --write",
		"test": "bun test",
		"test:coverage": "bun test --coverage"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.0.1",
		"@sentry/bun": "^10.5.0",
		"drizzle-orm": "^0.44.4",
		"fuse.js": "^7.1.0",
		"hono": "^4.9.2",
		"keyv": "^5.5.0",
		"pino": "^9.9.0",
		"pino-pretty": "^13.1.1",
		"quick-lru": "^7.0.1",
		"zod": "^4.0.17"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"@tailwindcss/cli": "^4.1.12",
		"@types/bun": "^1.2.20",
		"tailwindcss": "^4.1.12",
		"typescript": "^5.9.2"
	}
}
